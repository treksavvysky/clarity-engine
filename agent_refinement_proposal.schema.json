{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clarity Engine Agent Refinement Proposal",
  "description": "A source-bound agent proposal for human-reviewed Raw Intent grounding and clarification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_intent_sha",
    "proposer",
    "summary",
    "grounding_entries",
    "clarification_questions",
    "unresolved_gaps",
    "created_at"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "source_intent_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proposer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "transport"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "enum": [
            "mcp",
            "cli",
            "api",
            "import"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "grounding_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/groundingEntry"
      }
    },
    "clarification_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clarificationQuestion"
      }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "groundingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "statement",
        "sources"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "observation",
            "verified_fact",
            "rejected_assumption"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "clarificationQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
